submitBtn:{background:“linear-gradient(135deg,#059669,#34d399)”,border:“none”,color:”#0a0f1a”,fontSize:15,fontWeight:700,padding:“14px”,borderRadius:12,cursor:“pointer”,fontFamily:”‘DM Sans’,sans-serif”},
deleteBtn:{background:“none”,border:“none”,color:”#475569”,fontSize:13,cursor:“pointer”,padding:“4px 6px”},

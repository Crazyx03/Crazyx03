content:{overflowY:“auto”,height:“calc(100vh - 130px)”,paddingBottom:20},
screen:{padding:“0 16px”},
heroCard:{position:“relative”,background:“linear-gradient(145deg,#111827,#1e293b)”,borderRadius:20,padding:“28px 24px 20px”,marginBottom:12,overflow:“hidden”,border:“1px solid rgba(52,211,153,0.1)”},
heroGlow:{position:“absolute”,top:-40,right:-40,width:120,height:120,borderRadius:“50%”,background:“radial-gradient(circle,rgba(52,211,153,0.15),transparent 70%)”},
heroLabel:{fontSize:13,color:”#94a3b8”,fontWeight:500,marginBottom:4},
heroAmount:{fontSize:44,fontWeight:700,fontFamily:”‘JetBrains Mono’,monospace”,letterSpacing:-2,margin:“4px 0 2px”},
heroSub:{fontSize:12,color:”#64748b”,marginBottom:16},
healthBarOuter:{height:4,background:“rgba(255,255,255,0.06)”,borderRadius:2,marginBottom:18},
healthBarInner:{height:“100%”,borderRadius:2,transition:“width 0.6s ease”},
heroStats:{display:“flex”,justifyContent:“center”,alignItems:“center”,gap:28},
heroStat:{display:“flex”,flexDirection:“column”,alignItems:“center”},
heroStatVal:{fontSize:18,fontWeight:700,fontFamily:”‘JetBrains Mono’,monospace”,color:”#f1f5f9”},
heroStatLabel:{fontSize:11,color:”#64748b”,marginTop:2},
accumCard:{background:”#111827”,borderRadius:16,marginBottom:12,overflow:“hidden”,border:“1px solid rgba(129,140,248,0.12)”},
accumHeader:{padding:“14px 16px 0”},accumLabel:{fontSize:14,fontWeight:600,color:”#e2e8f0”},accumSub:{fontSize:11,color:”#64748b”,marginTop:2},
accumBody:{padding:“12px 16px”},accumMain:{display:“flex”,alignItems:“baseline”,gap:8,marginBottom:12},
accumAmount:{fontSize:30,fontWeight:700,fontFamily:”‘JetBrains Mono’,monospace”,letterSpacing:-1},accumTag:{fontSize:12,color:”#94a3b8”,fontWeight:500},
accumBreakdown:{background:“rgba(255,255,255,0.03)”,borderRadius:10,padding:“8px 12px”},
accumItem:{display:“flex”,justifyContent:“space-between”,padding:“5px 0”},accumItemL:{fontSize:12,color:”#94a3b8”},accumItemV:{fontSize:12,fontWeight:600,fontFamily:”‘JetBrains Mono’,monospace”,color:”#e2e8f0”},
statRow:{display:“flex”,gap:10,marginBottom:10},
statCard:{flex:1,background:”#111827”,borderRadius:14,padding:16,position:“relative”,overflow:“hidden”,border:“1px solid rgba(255,255,255,0.04)”},
statLabel:{fontSize:11,color:”#64748b”,fontWeight:500,marginBottom:6,paddingLeft:12},statValue:{fontSize:17,fontWeight:700,fontFamily:”‘JetBrains Mono’,monospace”,color:”#e2e8f0”,paddingLeft:12},
section:{background:”#111827”,borderRadius:16,padding:16,marginTop:10,border:“1px solid rgba(255,255,255,0.04)”},
sectionHeader:{display:“flex”,justifyContent:“space-between”,alignItems:“center”,marginBottom:12},sectionTitle:{fontSize:16,fontWeight:600,color:”#e2e8f0”},
seeAll:{background:“none”,border:“none”,color:”#34d399”,fontSize:13,fontWeight:500,cursor:“pointer”,fontFamily:”‘DM Sans’,sans-serif”},
monthNav:{display:“flex”,justifyContent:“space-between”,alignItems:“center”,marginBottom:8,padding:“0 4px”},
monthBtn:{background:“none”,border:“none”,cursor:“pointer”,padding:8,display:“flex”,alignItems:“center”},

tabBar:{position:“fixed”,bottom:0,left:“50%”,transform:“translateX(-50%)”,width:“100%”,maxWidth:420,display:“flex”,justifyContent:“space-around”,alignItems:“center”,padding:“8px 0 20px”,background:“linear-gradient(to top,#0a0f1a 80%,transparent)”,backdropFilter:“blur(20px)”,borderTop:“1px solid rgba(255,255,255,0.04)”},
tab:{display:“flex”,flexDirection:“column”,alignItems:“center”,gap:0,background:“none”,border:“none”,cursor:“pointer”,fontFamily:”‘DM Sans’,sans-serif”,padding:“4px 12px”},

function ExpensesScreen({ data, setData }) {
const [showAdd, setShowAdd] = useState(false);
const [name, setName] = useState(””);
const [amount, setAmount] = useState(””);

const add = () => {
if (!name || !amount) return;
setData(prev => ({ …prev, expenses: […prev.expenses, { id: Date.now(), name, amount: parseFloat(amount), date: new Date().toISOString().split(“T”)[0] }] }));
setName(””); setAmount(””); setShowAdd(false);
};

return (
<div style={S.screen}>
<div style={S.section}>
<div style={S.sectionHeader}>
<h3 style={{ …S.sectionTitle, marginBottom: 0 }}>All Expenses</h3>
<button style={S.addBtn} onClick={() => setShowAdd(!showAdd)}>{showAdd ? “✕” : “+ Add”}</button>
</div>
{showAdd && (
<div style={S.addForm}>
<input style={S.input} placeholder=“What was it?” value={name} onChange={e => setName(e.target.value)} />
<input style={S.input} placeholder=“Amount” type=“number” value={amount} onChange={e => setAmount(e.target.value)} />
<button style={S.submitBtn} onClick={add}>Log Expense</button>
</div>
)}
{data.expenses.slice().reverse().map(exp => (
<div key={exp.id} style={S.expenseRow}>
<div><p style={S.expenseName}>{exp.name}</p><p style={S.expenseDate}>{fmtDate(exp.date)}</p></div>
<div style={{ display: “flex”, alignItems: “center”, gap: 12 }}>
<p style={S.expenseAmt}>-${fmt$(exp.amount)}</p>
<button style={S.deleteBtn} onClick={() => setData(prev => ({ …prev, expenses: prev.expenses.filter(e => e.id !== exp.id) }))}>✕</button>
</div>
</div>
))}
</div>
<div style={{ height: 100 }} />
</div>
);
}

// ── Afford Screen ──

function AffordScreen({ data }) {
const [amount, setAmount] = useState(””);
const [result, setResult] = useState(null);
const c = useBudget(data);

const check = () => {
const p = parseFloat(amount);
if (!p || p <= 0) return;
const after = c.leftover - p;
setResult({ ok: after >= 0, p, before: c.leftover, after, days: c.daysLeft, dBefore: c.daily, dAfter: after / c.daysLeft });
};

return (
<div style={S.screen}>
<div style={S.section}>
<h3 style={{ …S.sectionTitle, marginBottom: 8 }}>Can I Afford It?</h3>
<p style={{ color: “#94a3b8”, fontSize: 14, marginBottom: 20, lineHeight: 1.5 }}>Check if a purchase fits before payday.</p>
<input style={{ …S.input, fontSize: 24, textAlign: “center”, padding: 16, fontWeight: 600 }} placeholder=”$0.00” type=“number” value={amount} onChange={e => { setAmount(e.target.value); setResult(null); }} />
<button style={{ …S.submitBtn, marginTop: 12 }} onClick={check}>Check</button>
</div>
{result && (
<div style={{ …S.section, marginTop: 16 }}>
<div style={{ display: “flex”, alignItems: “center”, justifyContent: “center”, gap: 8, padding: “12px 20px”, borderRadius: 12, marginBottom: 20, background: result.ok ? “rgba(52,211,153,0.15)” : “rgba(248,113,113,0.15)” }}>
<span style={{ fontSize: 20 }}>{result.ok ? “✓” : “✗”}</span>
<span style={{ fontSize: 16, fontWeight: 600, color: result.ok ? “#34d399” : “#f87171” }}>{result.ok ? “Yes, you can afford it” : “Over budget”}</span>
</div>
<RRow label=“Purchase” value={`$${fmt$(result.p)}`} />
<RRow label="Days left" value={result.days} />
<div style={{ height: 1, background: “rgba(255,255,255,0.06)”, margin: “8px 0” }} />
<RRow label=“Spendable before” value={`$${fmt$(result.before)}`} />
<RRow label=“Spendable after” value={`$${fmt$(result.after)}`} hl={!result.ok} />
<div style={{ height: 1, background: “rgba(255,255,255,0.06)”, margin: “8px 0” }} />
<RRow label=“Daily before” value={`$${fmt$(result.dBefore)}/day`} />
<RRow label=“Daily after” value={`$${fmt$(result.dAfter > 0 ? result.dAfter : 0)}/day`} hl={!result.ok} />
</div>
)}
<div style={{ height: 100 }} />
</div>
);
}


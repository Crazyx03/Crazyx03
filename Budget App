// ── Helpers ──

function getDaysLeft(endDate) {
const now = new Date();
const end = new Date(endDate + “T23:59:59”);
return Math.max(Math.ceil((end - now) / 86400000), 1);
}
function getDaysElapsed(startDate) {
const start = new Date(startDate + “T00:00:00”);
return Math.max(Math.floor((new Date() - start) / 86400000), 0);
}
function getTotalDays(s, e) {
return Math.ceil((new Date(e + “T23:59:59”) - new Date(s + “T00:00:00”)) / 86400000) + 1;
}
function ds(d) { return d.toISOString().split(“T”)[0]; }
function fmt$(n) { return Math.abs(n).toLocaleString(“en-US”, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
function fmtDate(str) { return new Date(str + “T12:00:00”).toLocaleDateString(“en-US”, { month: “short”, day: “numeric” }); }

function useBudget(data) {
const totalIncome = data.incomes.reduce((s, i) => s + i.amount, 0);
const totalBills = data.bills.reduce((s, b) => s + b.amount, 0);
const paidBills = data.bills.filter(b => b.paid).reduce((s, b) => s + b.amount, 0);
const unpaidBills = totalBills - paidBills;
const totalExp = data.expenses.reduce((s, e) => s + e.amount, 0);
const leftover = totalIncome - totalBills - totalExp;
const daysLeft = getDaysLeft(data.nextPayday);
const elapsed = getDaysElapsed(data.payPeriodStart);
const total = getTotalDays(data.payPeriodStart, data.nextPayday);
const daily = leftover / daysLeft;
const health = Math.min(Math.max(totalIncome > 0 ? leftover / totalIncome : 0, 0), 1);
const accumBudget = daily * (elapsed + 1);
const accumLeft = accumBudget - totalExp;
return { totalIncome, totalBills, paidBills, unpaidBills, totalExp, leftover, daysLeft, elapsed, total, daily, health, accumBudget, accumLeft };
}

// ── Full Month Calendar ──

function getMonthGrid(year, month) {
const first = new Date(year, month, 1);
const startDay = first.getDay();
const daysInMonth = new Date(year, month + 1, 0).getDate();
const prevDays = new Date(year, month, 0).getDate();
const cells = [];
for (let i = startDay - 1; i >= 0; i–) cells.push({ day: prevDays - i, inMonth: false, date: new Date(year, month - 1, prevDays - i) });
for (let i = 1; i <= daysInMonth; i++) cells.push({ day: i, inMonth: true, date: new Date(year, month, i) });
const remaining = 42 - cells.length;
for (let i = 1; i <= remaining; i++) cells.push({ day: i, inMonth: false, date: new Date(year, month + 1, i) });
const weeks = [];
for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7));
return weeks;
}

